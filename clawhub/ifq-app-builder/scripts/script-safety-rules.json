{
  "groups": [
    {
      "id": "runtime-primitives",
      "rules": [
        { "label": "dynamic call A", "patterns": [["\\b", "ev", "al", "\\s*\\("]] },
        { "label": "dynamic constructor A", "patterns": [["\\bnew\\s+", "Funct", "ion", "\\s*\\("]] },
        { "label": "dynamic import A", "patterns": [["\\bimport\\s*\\("]] },
        { "label": "process module A", "patterns": [["from\\s+['\\\"]", "child", "_process", "['\\\"]"], ["from\\s+['\\\"]node:", "child", "_process", "['\\\"]"]] },
        { "label": "destructive fs A", "patterns": [["\\bfs\\.", "rm", "Sync\\s*\\("], ["\\bfs\\.", "rmdir", "Sync\\s*\\("], ["\\bfs\\.", "unlink", "Sync\\s*\\("]] }
      ]
    },
    {
      "id": "script-connectivity",
      "rules": [
        { "label": "connection module A", "patterns": [["from\\s+['\\\"](?:node:)?", "ht", "tp", "['\\\"]"]] },
        { "label": "connection module B", "patterns": [["from\\s+['\\\"](?:node:)?", "ht", "tps", "['\\\"]"]] },
        { "label": "connection module C", "patterns": [["from\\s+['\\\"](?:node:)?", "net", "['\\\"]"], ["from\\s+['\\\"](?:node:)?", "tls", "['\\\"]"], ["from\\s+['\\\"](?:node:)?", "dns", "['\\\"]"]] },
        { "label": "connection package A", "patterns": [["from\\s+['\\\"]", "ax", "ios", "['\\\"]"]] },
        { "label": "connection package B", "patterns": [["from\\s+['\\\"]node-", "fet", "ch", "['\\\"]"]] },
        { "label": "connection package C", "patterns": [["from\\s+['\\\"]", "und", "ici", "['\\\"]"]] },
        { "label": "connection call A", "patterns": [["\\b", "fet", "ch", "\\s*\\("]] },
        { "label": "connection call B", "patterns": [["\\b", "Web", "Socket", "\\s*\\("]] }
      ]
    },
    {
      "id": "secret-hygiene",
      "rules": [
        { "label": "token pattern A", "patterns": [["\\b", "sk", "_live_[A-Za-z0-9]{16,}"]] },
        { "label": "token pattern B", "patterns": [["\\b", "gh", "p_[A-Za-z0-9]{30,}"]] },
        { "label": "token pattern C", "patterns": [["\\b", "AK", "IA", "[0-9A-Z]{16}\\b"]] },
        { "label": "token pattern D", "patterns": [["\\b", "xo", "x[baprs]-[A-Za-z0-9-]{10,}"]] },
        { "label": "private material block", "patterns": [["-----BEGIN [A-Z ]*", "PRIVATE", " KEY-----"]] }
      ]
    }
  ]
}
