{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peixl/ifq-app-builder/assets/templates/templates.schema.json",
  "title": "IFQ App Builder · template registry",
  "type": "object",
  "required": ["version", "author", "description", "modeRoutes"],
  "additionalProperties": false,
  "properties": {
    "$schema":     { "type": "string" },
    "version":     { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "author":      { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 16 },
    "modeRoutes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["mode", "templateId", "templateFile", "triggers", "stack", "artifact", "verify_command"],
        "additionalProperties": false,
        "properties": {
          "mode":          { "type": "string", "pattern": "^A-[0-9]{2}$" },
          "templateId":    { "type": "string", "pattern": "^T-[a-z0-9-]+$" },
          "templateFile":  { "type": "string", "pattern": "^[a-z0-9-]+\\.prompt\\.md$" },
          "triggers":      { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 2 } },
          "stack":         { "type": "string", "minLength": 4 },
          "artifact":      { "type": "string", "minLength": 3 },
          "verify_command":{ "type": "string", "pattern": "^npm run verify:lite" },
          "fallback_note": { "type": "string" },
          "example_prompt":{ "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
